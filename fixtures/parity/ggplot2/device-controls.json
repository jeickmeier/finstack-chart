{
  "reference": {
    "R": "4.6.1",
    "ggplot2": "4.0.3",
    "platform": "aarch64-apple-darwin23",
    "capabilities": {
      "jpeg": true,
      "png": true,
      "tiff": true,
      "tcltk": true,
      "X11": false,
      "aqua": true,
      "http/ftp": true,
      "sockets": true,
      "libxml": false,
      "fifo": true,
      "cledit": false,
      "iconv": true,
      "NLS": true,
      "Rprof": true,
      "profmem": true,
      "cairo": true,
      "ICU": true,
      "long.double": false,
      "libcurl": true
    }
  },
  "devices": [
    {
      "name": "jpeg",
      "formals": {
        "filename": "\"Rplot%03d.jpeg\"",
        "width": "480",
        "height": "480",
        "units": "\"px\"",
        "pointsize": "12",
        "quality": "75",
        "bg": "\"white\"",
        "res": "NA",
        "...": "",
        "type": "c(\"cairo\", \"Xlib\", \"quartz\")",
        "antialias": ""
      }
    },
    {
      "name": "tiff",
      "formals": {
        "filename": "\"Rplot%03d.tiff\"",
        "width": "480",
        "height": "480",
        "units": "\"px\"",
        "pointsize": "12",
        "compression": "c(\"none\", \"rle\", \"lzw\", \"jpeg\", \"zip\", \"lzw+p\", \"zip+p\", \"lerc\",      \"lzma\", \"zstd\", \"webp\")",
        "bg": "\"white\"",
        "res": "NA",
        "...": "",
        "type": "c(\"cairo\", \"Xlib\", \"quartz\")",
        "antialias": ""
      }
    },
    {
      "name": "bmp",
