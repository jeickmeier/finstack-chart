        "useKerning": "",
        "fillOddEven": ""
      }
    },
    {
      "name": "pictex",
      "formals": {
        "file": "\"Rplots.tex\"",
        "width": "5",
        "height": "4",
        "debug": "FALSE",
        "bg": "\"white\"",
        "fg": "\"black\""
      }
    },
    {
      "name": "svg",
      "formals": {
        "filename": "if (onefile) \"Rplots.svg\" else \"Rplot%03d.svg\"",
        "width": "7",
        "height": "7",
        "pointsize": "12",
        "onefile": "FALSE",
        "family": "\"sans\"",
        "bg": "\"white\"",
        "antialias": "c(\"default\", \"none\", \"gray\", \"subpixel\")",
        "symbolfamily": ""
      }
    },
    {
      "name": "pdf",
      "formals": {
