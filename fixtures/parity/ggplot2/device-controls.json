        "filename": "\"Rplot%03d.bmp\"",
        "width": "480",
        "height": "480",
        "units": "\"px\"",
        "pointsize": "12",
        "bg": "\"white\"",
        "res": "NA",
        "...": "",
        "type": "c(\"cairo\", \"Xlib\", \"quartz\")",
        "antialias": ""
      }
    },
    {
      "name": "postscript",
      "formals": {
        "file": "if (onefile) \"Rplots.ps\" else \"Rplot%03d.ps\"",
        "onefile": "",
        "family": "",
        "title": "",
        "fonts": "",
        "encoding": "",
        "bg": "",
        "fg": "",
