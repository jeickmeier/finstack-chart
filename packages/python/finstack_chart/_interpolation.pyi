    def from_json(cls, value: str, registry: ShapeRegistry | None = ...) -> Interpolator[InterpolationResult]: ...
    def to_json(self) -> str: ...
    def copy(self) -> Interpolator[_T]: ...
    def sample(self, t: float) -> _T: ...
    def __call__(self, t: float) -> _T: ...
    def sample_value(self, t: float) -> dict[str, object]: ...
    def sample_color(self, t: float) -> ColorValue: ...
    def sample_transform(self, t: float) -> list[float]: ...
    def quantize(self, count: int) -> list[_T]: ...
    @property
    def duration(self) -> float | None: ...
    @property
    def scheduling_duration(self) -> float | None: ...
class _FactoryBase(Generic[_T]): ...
class _GenericFactory(_FactoryBase[InterpolationResult]):
