class _SvgTransformFactory:
    @overload
    def __call__(self, a: str | None | MissingValue, b: str | None | MissingValue) -> Interpolator[str]: ...
    @overload
    def __call__(self, a: Sequence[float] | NumericArray, b: Sequence[float] | NumericArray) -> Interpolator[str]: ...
class _ZoomFactory:
    def __call__(self, a: Sequence[float] | NumericArray, b: Sequence[float] | NumericArray) -> Interpolator[list[float]]: ...
